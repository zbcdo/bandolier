# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env

# ── Admin user ──
NEW_USER=yourname
# Leave blank to be prompted (hidden input) at runtime instead of storing it here.
NEW_USER_PASSWORD=
# yes = passwordless sudo (then NEW_USER_PASSWORD may be blank). no = sudo asks for the password above.
SUDO_NOPASSWD=no

# ── SSH ──
# Local public key file to install on the server. Default: ~/.ssh/id_ed25519.pub
SSH_PUBKEY_FILE_LOCAL=
# Extra key(s) to install as well (e.g. your Windows/PuTTY key). Several: separate with \n inside quotes.
# Both this and the file are installed, so the machine running bandolier is never locked out.
SSH_PUBKEY=
# Port sshd will listen on AFTER bootstrap (and the port used for role runs).
SSH_PORT=22
# Port to reach root on for the very first bootstrap connection (almost always 22).
BOOTSTRAP_SSH_PORT=22

# ── Provider: auto | digitalocean | other ──
# digitalocean = also reuse the keys DO injected into root's authorized_keys. auto detects this.
PROVIDER=auto

# ── Firewall / system ──
OPEN_PORTS="80/tcp 443/tcp"
TIMEZONE=UTC
AUTO_REBOOT=true
AUTO_REBOOT_TIME=04:00
BTOP_MIN_MEM_GB=2
# Swap file: auto = 1G when RAM < 2GB, none otherwise. Or a size (2G) or none.
SWAP_SIZE=auto

# ── Role defaults (used by roles/*.sh) ──

# PostgreSQL (roles/postgres.sh). Major version: 16 | 17 | 18
PG_VERSION=16
# Port the server listens on (localhost only; never opened in the firewall — use an SSH tunnel).
PG_PORT=5432
# Superuser role for your desktop client. Default: NEW_USER. Leave the password blank to be prompted.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
# Memory settings are derived from the host's RAM; this one can be overridden.
PG_MAX_CONNECTIONS=

PHP_VERSION=8.5

# Caddy (roles/caddy.sh). One or more hostnames; blank = plain HTTP on :80 without TLS.
CADDY_DOMAIN=
# ACME account email (certificate expiry notices). Optional.
CADDY_EMAIL=
# Reverse-proxy target, e.g. 127.0.0.1:3000 or unix//run/app.sock. Blank = serve static files.
CADDY_UPSTREAM=
# Static site root when not proxying. Default: /var/www/<first domain>
CADDY_ROOT=
# yes = serve PHP through php-fpm (PHP_VERSION) from CADDY_ROOT. Requires the php role.
CADDY_PHP=no
# yes = DNS is proxied through Cloudflare: forward CF-Connecting-IP to the upstream as the client address.
CADDY_CLOUDFLARE=no
